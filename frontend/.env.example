# Frontend settings. Copy to `.env.local` for local development.
# Only public values belong here: anything starting with NEXT_PUBLIC_ is
# bundled into the browser. Never put API keys or passwords in this file.

# Base URL of the FastAPI backend. Leave empty (or delete .env.local) to run
# in demo mode with clearly labelled sample data (no sign-in).
# Live mode needs an account: create it on the sign-in page the first time.
# The browser never calls this address directly: Next.js forwards /api/v1/* to it.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Sign-in is Supabase Auth. Both values are PUBLIC (Project Settings -> API -> the anon key). Leave empty in demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
