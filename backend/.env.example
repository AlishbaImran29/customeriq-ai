# CustomerIQ AI backend settings.
# Copy this file to `.env` (same folder) and fill in real values there.
# `.env` is gitignored — never commit it or paste its contents anywhere.

# --- PostgreSQL ------------------------------------------------------------
# Option A (local development): separate fields. The password may contain any
# characters; it is escaped automatically.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=customeriq
DB_USER=customeriq_app
DB_PASSWORD=
# For a hosted database (Supabase etc.) also set: DB_SSLMODE=require
# DB_SSLMODE=
# On Vercel (serverless) use a small pool: DB_POOL_SIZE=1 and DB_MAX_OVERFLOW=1
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# Option B (hosted databases such as Supabase/Railway): one full URL.
# If set, it overrides the fields above. Use the postgresql+psycopg:// scheme.
# DATABASE_URL=

# --- CORS ------------------------------------------------------------------
# Comma-separated browser origins allowed to call this API (the Next.js app).
# Also used to reject state-changing requests that come from other websites.
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Login (Supabase Auth: email + password, no email confirmation) --------------
# development (default) or production. Production hides the interactive API docs.
APP_ENV=development
# Supabase project address and the PUBLIC anon key (Project Settings -> API). The backend uses them to check sign-in tokens.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Recommended on a public site: only this address can become the owner when the site has none yet.
# Everyone else waits for the owner's approval on the Team page.
# OWNER_EMAIL=

# --- AI (Launch Studio ideas / ad copy and Auto Messenger campaign drafts) ------
# Server-side only. Never put keys in the frontend or in NEXT_PUBLIC_* vars.
# Leave the key empty to keep the AI features switched off ("not configured").
# Provider: anthropic (Claude, default) or openai.
AI_PROVIDER=anthropic

# Anthropic API key from https://platform.claude.com (Claude Console -> API keys).
# API usage is billed separately from Claude Pro/Max subscriptions: the account
# needs API credits.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Only used when AI_PROVIDER=openai (needs an OpenAI API account with credits).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# --- Email (sends the sign-up verification code) ---------------------------------------
# Leave these empty and accounts are created without email verification (and only the owner
# account can be created). To use Gmail: turn on 2-Step Verification, create an "App password"
# at https://myaccount.google.com/apppasswords and paste it below (never your normal password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourname@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_SECURITY=starttls
# Hosts such as Vercel cannot reach SMTP servers. Send through your own Gmail with the Google script
# in docs/mail-relay.gs instead (free; see "Email codes" in docs/DEPLOY.md):
# MAIL_WEBHOOK_URL=
# MAIL_WEBHOOK_SECRET=
# Or Brevo's HTTPS API:
# BREVO_API_KEY=
# MAIL_FROM=   # a sender address you verified in Brevo

# Launch Studio: competitor-ad screenshots (optional). Create a PRIVATE bucket named competitor-ads in
# Supabase (Storage -> New bucket, leave Public OFF). SUPABASE_URL is your project address; the service key is
# under Project Settings -> API (the secret one, never put it in the website project).
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=competitor-ads

# --- Auto Messenger (WhatsApp and email messages) -------------------------------------------------------
# True = NOTHING is really sent: messages are only written to the log and the database. Keep it true for demos.
MESSAGING_DRY_RUN=true
# A long random text. It signs the unsubscribe link in emails so nobody can unsubscribe someone else.
MESSAGING_SECRET=
# The public address of THIS API (no slash at the end). It goes inside unsubscribe links.
PUBLIC_API_URL=
# WhatsApp Cloud API (Meta). The test phone number from Meta works for demos.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Shopify webhooks: the signing secret shown on Shopify's webhook page (and optionally your shop's address).
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_SHOP_DOMAIN=
# The shared secret the scheduler (GitHub Actions) sends to run due messages.
SCHEDULER_SECRET=
# Private bucket for customer videos (Supabase Storage). SUPABASE_URL and SUPABASE_SERVICE_KEY are above.
SUPABASE_MEDIA_BUCKET=customer-media

# Workflows may call only these https addresses (comma separated). Empty = the call-a-web-address action is refused.
WORKFLOW_WEBHOOK_URLS=

# Leads
LEAD_SLA_HOURS=24
PUBLIC_LEADS_ENABLED=false
META_PAGE_TOKEN=
# Returns: private bucket for photos and videos
SUPABASE_EVIDENCE_BUCKET=return-evidence

# Meta Ads (test mode is ON until META_ADS_DRY_RUN=false)
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PIXEL_ID=
META_ADS_DRY_RUN=true

# --- Email Automations (COD confirmation, win-back and new-product emails through Brevo) --------------------------
# Brevo free plan: 300 emails a day. Leave BREVO_API_KEY empty for TEST MODE: emails are written to the log only.
# BREVO_API_KEY=            # Brevo -> SMTP & API -> API keys (the v3 key)
# SENDER_EMAIL=             # a sender you VERIFIED in Brevo (Senders & IP). Test emails and replies go here.
# SENDER_NAME=              # shown as the sender name and used as the store name until you set one on the page
# APP_URL=                  # your shop's web address (https://...), used for the "Visit store" button
# The confirm / cancel / unsubscribe links also need these two (they are the same ones the Auto Messenger uses):
# MESSAGING_SECRET=         # long random text that signs the links
# PUBLIC_API_URL=           # the public address of THIS API, e.g. https://your-api.vercel.app (http://127.0.0.1:8000 locally)
