# CustomerIQ AI backend settings.
# Copy this file to `.env` (same folder) and fill in real values there.
# `.env` is gitignored — never commit it or paste its contents anywhere.

# --- PostgreSQL ------------------------------------------------------------
# Option A (local development): separate fields. The password may contain any
# characters; it is escaped automatically.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=customeriq
DB_USER=customeriq_app
DB_PASSWORD=
# For a hosted database (Supabase etc.) also set: DB_SSLMODE=require
# DB_SSLMODE=

# Option B (hosted databases such as Supabase/Railway): one full URL.
# If set, it overrides the fields above. Use the postgresql+psycopg:// scheme.
# DATABASE_URL=

# --- CORS ------------------------------------------------------------------
# Comma-separated browser origins allowed to call this API (the Next.js app).
# Also used to reject state-changing requests that come from other websites.
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Login ---------------------------------------------------------------------
# development (default) or production. Production uses secure cookies (needs HTTPS)
# and hides the interactive API docs.
APP_ENV=development
# Optional but REQUIRED for a public deployment: the first account can only be
# created on the website by someone who knows this code.
# SETUP_CODE=

# --- AI assistant ------------------------------------------------------------
# Server-side only. Never put keys in the frontend or in NEXT_PUBLIC_* vars.
# Leave the key empty to keep the assistant switched off ("not configured").
# Provider: anthropic (Claude, default) or openai.
AI_PROVIDER=anthropic

# Anthropic API key from https://platform.claude.com (Claude Console -> API keys).
# API usage is billed separately from Claude Pro/Max subscriptions: the account
# needs API credits.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Only used when AI_PROVIDER=openai (needs an OpenAI API account with credits).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
